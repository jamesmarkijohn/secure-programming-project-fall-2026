# PostgreSQL
POSTGRES_DB=gallery
POSTGRES_USER=gallery
POSTGRES_PASSWORD=<postgres_password>

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost

# Field-level encryption key
FIELD_ENCRYPTION_KEY=change-me

# Generate real values with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"        -> DJANGO_SECRET_KEY
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"        -> FIELD_ENCRYPTION_KEY
