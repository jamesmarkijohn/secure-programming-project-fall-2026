# Run ./setup.sh to create the real .env

# PostgreSQL
POSTGRES_DB=gallery
POSTGRES_USER=gallery
POSTGRES_PASSWORD=change-me

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost

# Field-level encryption key using Fernet
FIELD_ENCRYPTION_KEY=change-me

# Public key for encrypting backups with age
BACKUP_PUBLIC_KEY=change-me